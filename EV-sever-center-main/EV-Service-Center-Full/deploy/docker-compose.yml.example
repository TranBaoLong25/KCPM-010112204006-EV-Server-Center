version: '3.8'
services:
  booking-service:
    image: yourdockerhubusername/booking-service:latest
    restart: unless-stopped
    ports:
      - "5001:5000"
    environment:
      - FLASK_ENV=production
      - DATABASE_URL=sqlite:///booking.db
    volumes:
      - booking-data:/var/lib/booking

volumes:
  booking-data:
    driver: local
